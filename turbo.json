{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_ENSFORGE_MAINNET_RPC_URL",
        "VITE_ENSFORGE_MAINNET_V1_INDEXER_URL",
        "VITE_ENSFORGE_MAINNET_V2_INDEXER_URL",
        "VITE_ENSFORGE_SEPOLIA_RPC_URL",
        "VITE_ENSFORGE_SEPOLIA_V1_INDEXER_URL",
        "VITE_ENSFORGE_SEPOLIA_V2_INDEXER_URL",
        "VITE_WALLETCONNECT_PROJECT_ID"
      ],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "outputs": [] },
    "pack:check": { "dependsOn": ["build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build", "^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:watch": { "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
