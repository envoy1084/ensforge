{
  "name": "@ensforge/test-env",
  "version": "0.0.0",
  "private": true,
  "description": "Private local ENS v1 and v2 contract test environment for ensforge",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./verify": {
      "workspace-source": "./src/verify.ts",
      "default": "./dist/verify.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./verify": "./dist/verify.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "verify": "pnpm --filter @ensforge/core build && pnpm build && node dist/verify.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensforge/contracts": "workspace:*",
    "@ensforge/core": "workspace:*",
    "effect": "catalog:",
    "viem": "catalog:"
  }
}
