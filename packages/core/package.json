{
  "name": "@ensforge/core",
  "version": "0.1.1",
  "description": "Type-safe actions and utilities for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://github.com/envoy1084/ensforge#readme",
  "bugs": "https://github.com/envoy1084/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envoy1084/ensforge.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "workspace-source": "./src/testing/index.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "bench": "vitest bench --run bench",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./testing",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "catalog:",
    "@ensdomains/content-hash": "catalog:",
    "@ensforge/contracts": "workspace:*",
    "cborg": "catalog:",
    "fflate": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "viem": "^2.56.0",
    "wagmi": "^3.0.0"
  }
}
