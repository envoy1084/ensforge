{
  "name": "ensforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "pack:check": "turbo run pack:check",
    "prepare": "lefthook install",
    "release": "pnpm check && changeset publish",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @ensforge/test-env test:integration",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@effect/vitest": "catalog:",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "effect": "catalog:",
    "klarity": "0.2.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
